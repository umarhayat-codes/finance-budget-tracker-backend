// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  email        String        @unique
  password     String
  role         Role          @default(USER)
  transactions Transaction[]
  categories   Category[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  budgets      Budget[]
  goals        Goal[]
  reminders    Reminder[]
  savings      Saving[]
  profile      Profile?
}

model Profile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id])
  phoneNumber    String
  dateOfBirth    String
  paymentMethod  String
  cardNumber     String
  billingAddress String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("profiles")
}

model Reminder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  amount    String   // Keeping as String per request/hook usage, or Float? Hook uses string.
  dateStr   String   // "Tomorrow, Jan 20" etc
  type      String   // "creditCard", "electricity" etc.
  subtitle  String?  @default("New Reminder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reminders")
}

model Goal {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  goalName      String
  targetAmount  Float
  targetDate    String
  goalType      String
  fundingSource String
  goalStatus    String   @default("On Track")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("goals")
}

model Budget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  category  String
  amount    Float
  month     String
  year      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("budgets")
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  category  String
  date      String
  time      String
  amount    Float
  method    String
  type      String   // Using String instead of Enum for simplicity or can use enum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transaction_activity")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  name      String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

enum Role {
  USER
  ADMIN
}

model Saving {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  amount    Float
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("savings")
}